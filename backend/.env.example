# TruthTrace — Required Environment Variables
# Copy this to .env and fill in your values (NEVER commit .env)

# ── Server ─────────────────────────────────────────────────────────────────────
DEBUG=False
HOST=0.0.0.0
PORT=8001

# ── CORS — set to your frontend URL in production ──────────────────────────────
CORS_ORIGINS=["https://your-frontend.onrender.com","http://localhost:5173"]

# ── LLM — Google Gemini ────────────────────────────────────────────────────────
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ── Optional news sources (RSS works without these) ────────────────────────────
# NewsAPI: https://newsapi.org/register
NEWS_API_KEY=

# Google Fact Check Tools API: https://console.cloud.google.com
GOOGLE_FACT_CHECK_API_KEY=
